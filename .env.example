# Copy to .env (never commit real secrets).

# PostgreSQL 16 (matches the `db` service in docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://calorie:calorie@db:5432/calorie

# JWT signing
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# USDA FoodData Central API key - server-side only, never sent to the browser.
NUTRITION_API_KEY=

# Server binding (must stay 0.0.0.0 inside Docker)
HOST=0.0.0.0
PORT=8080

# Built React assets served at /
STATIC_DIR=/app/static

# Comma separated list, or * for all
CORS_ORIGINS=*
